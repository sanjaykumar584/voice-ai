# =====================================================================
#  CONFIGURATION — Outbound EMI Collections Voice Agent
#  Copy this file to `.env` and edit the copy. Restart the bot after
#  every change. Full explanations + experiment ranges: see CONFIG.md.
# =====================================================================

# --- AI provider (Sarvam) ------------------------------------------------
SARVAM_API_KEY=

# --- LLM (Sarvam sarvam-105b — only supported model) ---------------------
# Latency vs reasoning. "low" = faster replies (scripted bot doesn't need deep
# reasoning). Options: low | medium | high.
SARVAM_LLM_REASONING_EFFORT=low
# Disable wiki-grounding (adds latency). true | false
SARVAM_LLM_WIKI_GROUNDING=false
# Max response tokens. Lower = shorter/faster, but can truncate. Script wants
# <=10 words, so ~120-200 is plenty.
SARVAM_LLM_MAX_TOKENS=150
# Response randomness. 0.0 = deterministic, 1.0 = creative. Keep 0.3-0.6 for a
# consistent scripted tone.
SARVAM_LLM_TEMPERATURE=0.5

# --- STT (Sarvam) ---------------------------------------------------------
# Models: saarika:v2.5 | saaras:v2.5 | saaras:v3
SARVAM_STT_MODEL=saaras:v3
# Sarvam's own VAD drives turn boundaries. Keep true (short-utterance fix).
SARVAM_STT_VAD_SIGNALS=true
# More sensitive to soft/quiet speech. true = better short replies, may hear
# more background noise as "speech".
SARVAM_STT_HIGH_VAD_SENSITIVITY=true
# Seconds of silence sent to keep the WebSocket alive. Empty = disabled.
SARVAM_STT_KEEPALIVE_TIMEOUT=10
SARVAM_STT_KEEPALIVE_INTERVAL=5

# Fine-grained VAD (saaras:v3 ONLY — ignored/errors on other models).
# Leave EMPTY to use Sarvam's server defaults. Tune only if needed:
#   * Short utterances getting dropped     -> lower MIN_SPEECH_FRAMES,
#     FIRST_TURN_MIN_SPEECH_FRAMES (below).
#   * Replies feel too slow (wait for "end of speech") -> lower
#     NEGATIVE_FRAMES_COUNT / NEGATIVE_FRAMES_WINDOW (end sooner on silence).
# Units are Sarvam audio frames (not seconds) — experiment in small steps.
SARVAM_STT_MIN_SPEECH_FRAMES=
SARVAM_STT_FIRST_TURN_MIN_SPEECH_FRAMES=
SARVAM_STT_NEGATIVE_FRAMES_COUNT=
SARVAM_STT_NEGATIVE_FRAMES_WINDOW=
SARVAM_STT_START_SPEECH_VOLUME_THRESHOLD=
SARVAM_STT_POSITIVE_SPEECH_THRESHOLD=
SARVAM_STT_NEGATIVE_SPEECH_THRESHOLD=

# --- TTS (Sarvam) ---------------------------------------------------------
# Models: bulbul:v2 (22050 Hz) | bulbul:v3-beta (24000 Hz)
# If you switch to bulbul:v2, set SARVAM_TTS_SAMPLE_RATE=22050.
SARVAM_TTS_MODEL=bulbul:v3-beta
SARVAM_TTS_SAMPLE_RATE=24000
# Voice. v3 voices: aditya, priya, neha, rahul, pooja, rohan, simran, kavya, ...
SARVAM_VOICE=priya
# Chars buffered before TTS starts speaking. Lower = faster first audio, but
# can sound choppy if too low. Typical range 10-50.
SARVAM_TTS_MIN_BUFFER_SIZE=12
# Max chars per synthesis chunk. Higher = fewer requests, more buffering.
SARVAM_TTS_MAX_CHUNK_LENGTH=150

# --- Turn-taking / reply latency -----------------------------------------
# Seconds of silence (after the last transcript) before the bot replies.
# Lower = snappier but can cut off a caller mid-thought. Typical 0.5-1.5.
TURN_SPEECH_TIMEOUT=0.8

# --- Dev / logging --------------------------------------------------------
# INFO shows [METRICS] latency per turn. DEBUG also shows transcripts + turn
# frames (very noisy, for diagnosing STT/turn issues).
LOG_LEVEL=INFO
# Mock call data for the browser test (no Vobiz /start body in that mode).
DEV_REMINDER_BODY={"agent_name":"Meena","company_name":"ABC Finance","customer_name":"Kumar","account_number_last4":"1234","principal":371987,"emi":11183,"first_due_date":"2025-07-01","tenor_months":36,"emis_received":6}


# =====================================================================
#  VOBiz TELEPHONY (phone mode only — `python server.py`)
# =====================================================================
# --- Vobiz account ---
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
# The Vobiz number outbound calls are placed FROM (caller-id). Used by /start
# when "from_number" is not in the request body.
VOBIZ_PHONE_NUMBER=

# --- Vobiz wire format ---
# Allowed encodings: audio/x-mulaw | audio/x-l16
# Allowed rates (Hz): 8000 | 16000  (24000 is in the protocol but not reliably
# available on all regions — Vobiz silently refuses the WS upgrade)
VOBIZ_ENCODING=audio/x-mulaw
VOBIZ_SAMPLE_RATE=8000
# L16 byte order on the wire. RFC says "be", some accounts transport "le".
# Ignored for audio/x-mulaw.
VOBIZ_L16_ENDIAN=le

# --- Deployment ---
# local | production
ENV=local
# Public https:// URL where Vobiz reaches your /answer endpoint (ngrok in dev).
PUBLIC_URL=
# Only when ENV=production: public wss:// URL where the bot is hosted.
VOBIZ_PROD_WS_URL=

# --- Human-transfer flow ---
TRANSFER_AGENT_NUMBER=

# --- Recording ---
ENABLE_RECORDING=true
MAX_RECORDING_LENGTH=3600

# --- Pipecat Cloud (only when ENV=production) ---
AGENT_NAME=
ORGANIZATION_NAME=
